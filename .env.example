# Rituva runtime configuration — copy to `.env` and fill in. NEVER commit `.env`.
# All values are optional; with none set, Rituva runs on SQLite with no LLM.

# --- Database ---------------------------------------------------------------
# Unset  -> local SQLite file (rituva.db).
# Set    -> Postgres (Cloud SQL etc.); requires psycopg[binary] (in the Docker image).
# RITUVA_DB=postgresql://rituva:PASSWORD@127.0.0.1:5432/rituva

# --- LLM (optional; the deterministic planner runs fine without it) ---------
# Provider: none | nvidia | openai | gemini | ollama
# RITUVA_LLM_PROVIDER=nvidia
# For Google Gemini (natural on GCP): RITUVA_LLM_PROVIDER=gemini + GEMINI_API_KEY (AI Studio key)
# GEMINI_API_KEY=AIza...
# NVIDIA NIM key from https://build.nvidia.com  (the gateway auto-selects a model
# and falls back gracefully). Only the friendly explanation uses the LLM — never
# any nutrient number.
# NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# OPENAI_API_KEY=sk-XXXX            # if RITUVA_LLM_PROVIDER=openai
